{
    "name": "orangecatprog-website",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "prepare": "husky",
        "lint": "eslint . --ext .ts,.js,.mjs,.cjs,.md,.css,.astro",
        "lint:fix": "eslint . --ext .ts,.js,.mjs,.cjs,.md,.css,.astro --fix",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "check": "astro check"
    },
    "dependencies": {
        "@astrojs/react": "^6.0.2",
        "@astrojs/sitemap": "^3.7.3",
        "astro": "^7.1.6",
        "react": "^19.2.8",
        "react-dom": "^19.2.8",
        "sharp": "^0.35.3"
    },
    "devDependencies": {
        "@astrojs/check": "^0.9.10",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@commitlint/types": "^21.2.0",
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^9",
        "@eslint/markdown": "^8.0.3",
        "@types/react": "^19.2.18",
        "astro-eslint-parser": "^3.0.0",
        "commitizen": "^4.3.2",
        "cz-git": "^1.13.1",
        "eslint": "^9",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-astro": "^3.0.1",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "knip": "^6.31.0",
        "lint-staged": "^17.3.0",
        "prettier": "^3.9.6",
        "prettier-plugin-astro": "^0.14.1",
        "typescript-eslint": "^8.65.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,scss,html}": [
            "prettier --write"
        ]
    },
    "config": {
        "commitizen": {
            "path": "cz-git"
        }
    },
    "overrides": {
        "brace-expansion": "^5.0.9"
    }
}
