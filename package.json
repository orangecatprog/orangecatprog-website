{
    "name": "orangecatprog-website",
    "type": "module",
    "version": "0.0.1",
    "engines": {
        "node": ">=22.12.0"
    },
    "scripts": {
        "dev": "astro dev",
        "build": "astro build",
        "preview": "astro preview",
        "astro": "astro",
        "lint": "eslint . --ext .ts,.js,.mjs,.cjs,.md,.json,.jsonc,.json5,.css",
        "format": "prettier --write .",
        "prepare": "husky"
    },
    "dependencies": {
        "astro": "^7.1.6"
    },
    "devDependencies": {
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/css": "^1.4.0",
        "@eslint/js": "^10.0.1",
        "@eslint/json": "^2.0.1",
        "@eslint/markdown": "^8.0.3",
        "commitizen": "^4.3.2",
        "cz-git": "^1.13.1",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "globals": "^17.8.0",
        "husky": "^9.1.7",
        "jiti": "^2.7.0",
        "lint-staged": "^17.3.0",
        "prettier": "3.9.6",
        "typescript-eslint": "^8.65.0"
    },
    "lint-staged": {
        "*.{js,mjs,cjs,ts,mts,cts,jsx,tsx,astro}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,yml,yaml,css,scss,html}": [
            "prettier --write"
        ]
    },
    "config": {
        "commitizen": {
            "path": "cz-git"
        }
    }
}
