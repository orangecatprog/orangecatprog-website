# Auto detect text files and normalize line endings
* text=auto eol=lf

# Source code
*.ts text
*.tsx text
*.js text
*.jsx text
*.mjs text
*.cjs text
*.json text
*.astro text
*.css text
*.scss text
*.html text
*.md text
*.mdx text
*.yml text
*.yaml text
*.toml text
*.svg text

# Shell scripts
*.sh text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary
*.pdf binary