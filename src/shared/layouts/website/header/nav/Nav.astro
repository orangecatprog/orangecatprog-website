---
import { Image } from "astro:assets";
import "./Nav.css";

import mainNav from "./mainNav.json";

import logo_2000 from "@/assets/icons/orange/icon_2000.png";
import ThemeToggler from "../../theme/ThemeToggler.astro";
---

<nav class="nav">
    <a href="/" class="nav__logo">
        <Image src={logo_2000} alt="Logo de Orange Cat" width="50" loading="eager" />
    </a>
    <ThemeToggler />

    <input type="checkbox" id="menu-toggle" class="nav__checkbox" />

    <label for="menu-toggle" class="nav__button">
        <span></span>
        <span></span>
        <span></span>
    </label>

    <ul class="nav__links">
        {
            mainNav.map((item) => (
                <li>
                    <a href={item.href}>{item.name}</a>
                </li>
            ))
        }
    </ul>
</nav>
